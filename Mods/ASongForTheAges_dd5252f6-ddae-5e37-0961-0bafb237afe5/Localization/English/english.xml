  <content contentuid="h0db39e6ag53a1gc981g61d1g2e626ca3bb7c" version="3">Hey, I wasnt sleeping</content>
  <content contentuid="hf3019d4cg2cf9g0276g1e88g35dde2b80c78" version="3">I totally believe you</content>
  <content contentuid="h07304c5bg90c9g2d7ag7032ga2a2b2b63e36" version="3">Right...</content>
  <content contentuid="h4328f3b7ge07cga161g27c1g982b7790a4ce" version="3">No seriously, Im awake!!</content>
  <content contentuid="hb40c2746g9b18gbaadg1216g36f070c0b75d" version="6">Hey, you there...</content>
  <content contentuid="h5a3f6cd2gb606g93d9gac76g6fe0a6688b03" version="6">What do you want?</content>
  <content contentuid="h8ccf0983gf080g8afegf331g3008a1a36c2e" version="6">&lt;b&gt;Go away.&lt;/b&gt;</content>
  <content contentuid="hc1f2fbb7g991eg1441ga9eege91a18596c79" version="6">I lost my lute...</content>
  <content contentuid="h58ba8122g74d9g7cfdg3c1bg65257c695a9b" version="4">Go get my lute</content>
  <content contentuid="hf64db892g6b03g5a9cg9125gaafcefd6bfe1" version="4">&lt;b&gt;NO&lt;/b&gt;</content>
  <content contentuid="h63e276e0gcb33g5e4dg6c78gb31d68c5e5a9" version="4">Ok</content>
  <content contentuid="h7e4ae732g1e76g5d83g64edg34661e0690f5" version="4">Its in that cave over there</content>
  <content contentuid="hdaae1174ga453gc05ega02bgbbd94fcab753" version="2">Sten</content>
  <content contentuid="h86a22930gf467g2106g8900gb57412fd00c1" version="2">A Song For The Ages</content>
  <content contentuid="hcba8ecd2g4b53g55c9g9329gba5bfef510a1" version="4">Search your surroundings for Stens lute</content>
  <content contentuid="h1e649f2eg87a5g81d2g270bg34acec106c7b" version="2">Find the lute for Sten</content>
  <content contentuid="h7884e5fdg073agc734gda73g71b727c3b602" version="2">Return the lute to Sten</content>
  <content contentuid="h74453ec1g590dg0f3aga6bcg9904b29e7d18" version="7">Hey, I wasn't sleeping</content>
  <content contentuid="h35ee0edag55a7g8721geeeag96633524b42e" version="7">Sure, I believe you</content>
  <content contentuid="h1d1f3cb9g8578gf1b8gca38gae3b11f4ecb5" version="7">Right...</content>
  <content contentuid="h488bc316g6ec2g1729g619fgeab514127741" version="7">No seriously, Im awake.</content>
  <content contentuid="hb0922f94gf39fg99feg95ccgbea1bbb6816a" version="1">Raphael</content>
  <content contentuid="h5e7f891fg181eg7f6bg32bdgff46df89294c" version="1">OG Master of the Game Design</content>
